*.log
.DS_Store

# Comes from your own Firebase project — never commit it.
google-services.json

# Build output
*.apk
*.aab

# Signing key — losing this means you can never update an installed APK.
credentials/

# Firebase service-account keys. These are full admin credentials for the
# Firebase project and belong on the server, never in the repo — a broad
# pattern because they arrive from the console with an unpredictable name.
*firebase-adminsdk*.json
*service-account*.json
serviceAccountKey.json
