# ─────────────────────────────────────────────
#  NexChat API — environment
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=NexChat
CLIENT_URL=http://localhost:3000

# Database — use a local mongod, MongoDB Atlas, or set USE_MEMORY_DB=true
MONGODB_URI=mongodb://127.0.0.1:27017/nexchat
USE_MEMORY_DB=false
# Only used for mongodb+srv:// URIs, where some resolvers fail on SRV records.
# Comma-separated list, or `off` to keep the system resolver.
DNS_SERVERS=

# Tokens (CHANGE THESE IN PRODUCTION)
JWT_ACCESS_SECRET=dev_access_secret_change_me_please_0123456789
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_please_9876543210
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=60d

# Mail — leave SMTP_HOST empty to auto-create an Ethereal inbox (dev)
# and print the preview URL + code in the server console.
#
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char App Password, not your login password>
#   MAIL_FROM="NexChat <you@gmail.com>"
# App passwords need 2-Step Verification on:
# myaccount.google.com → Security → 2-Step Verification → App passwords
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NexChat <no-reply@nexchat.app>"

# Uploads
MAX_UPLOAD_MB=50
UPLOAD_DIR=uploads

# Web Push (VAPID). Leave blank and the server generates a temporary pair and
# prints it at startup — copy it here so subscriptions survive a restart.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@nexchat.app

# Forensic attestation authority — the key this server uses to counter-sign
# forensic export Merkle roots, so an export's timestamp does not rest on the
# exporting device's own clock. Generate one by starting the server without it:
# a temporary key is minted and printed. Persist it before relying on any
# export, because regenerating it makes every attestation already issued
# permanently unverifiable.
FORENSIC_ATTEST_KEY=
