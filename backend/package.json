{
  "name": "nexchat-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NexChat API \u2014 realtime end-to-end encrypted messaging backend",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "dev:mem": "cross-env USE_MEMORY_DB=true nodemon src/server.js",
    "smoke": "node scripts/smoke-test.mjs",
    "test:features": "node scripts/feature-test.mjs",
    "test:forensics": "node scripts/forensics.test.mjs && node scripts/reconcile.test.mjs",
    "verify-export": "node scripts/verify-export.mjs",
    "reconcile": "node scripts/reconcile-exports.mjs",
    "test:contacts": "node scripts/contacts.test.mjs",
    "test:feed": "node scripts/feed.test.mjs",
    "test:secret": "node scripts/secret.test.mjs",
    "test:push": "node scripts/pushdelivery.test.mjs",
    "test:presence": "node scripts/presence.test.mjs",
    "test:turn": "node scripts/turn.test.mjs",
    "test": "npm run test:forensics && npm run test:contacts && npm run test:feed && npm run test:secret && npm run test:presence && npm run test:turn && npm run test:push && npm run test:conversations",
    "test:conversations": "node scripts/conversations.test.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "argon2": "^0.41.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.9",
    "nodemailer": "^6.9.16",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "ua-parser-js": "^1.0.39",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}
