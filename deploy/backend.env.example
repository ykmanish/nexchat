# Copy to /var/www/nexchat/backend/.env on the server and fill in.
# Never commit the real file — it holds your SMTP password and JWT secrets.

NODE_ENV=production
# 5100, not 5000 — splitta is already on this box.
PORT=5100
APP_NAME=NexChat

# Drives CORS and the Socket.IO origin allowlist. Must be the exact scheme +
# host the browser uses, with no trailing slash. Comma-separate for several.
CLIENT_URL=https://chax.nexarrow.eu

# Reuse the MONGODB_URI you already have, or point at a local mongod:
#   mongodb://127.0.0.1:27017/nexchat
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/nexchat?retryWrites=true&w=majority
USE_MEMORY_DB=false

# Generate each with:  openssl rand -base64 48
# Changing either signs every existing session out.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=60d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=junipernymous@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM=NexChat <junipernymous@gmail.com>

# Keep below nginx's client_max_body_size (60m) or uploads 413 at the proxy.
MAX_UPLOAD_MB=50
# Absolute, and deliberately outside /var/www/nexchat: attachments must not
# live inside the git working tree that every deploy resets.
UPLOAD_DIR=/var/www/nexchat-data/uploads

# Generate once with:  npx web-push generate-vapid-keys
# The server mints a temporary pair when these are blank and logs it — but a
# fresh pair on every restart invalidates every push subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@chax.nexarrow.eu
