# Copy to /var/www/nexchat/backend/.env on the server and fill in.
# Never commit the real file — it holds your SMTP password and JWT secrets.

NODE_ENV=production
# 5100, not 5000 — splitta is already on this box.
PORT=5100
APP_NAME=NexChat

# Drives CORS and the Socket.IO origin allowlist. Must be the exact scheme +
# host the browser uses, with no trailing slash. Comma-separate for several.
CLIENT_URL=https://chax.nexarrow.eu

# Reuse the MONGODB_URI you already have, or point at a local mongod:
#   mongodb://127.0.0.1:27017/nexchat
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/nexchat?retryWrites=true&w=majority
USE_MEMORY_DB=false

# Generate each with:  openssl rand -base64 48
# Changing either signs every existing session out.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=60d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=junipernymous@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM=NexChat <junipernymous@gmail.com>

# Keep below nginx's client_max_body_size (60m) or uploads 413 at the proxy.
MAX_UPLOAD_MB=50
# Absolute, and deliberately outside /var/www/nexchat: attachments must not
# live inside the git working tree that every deploy resets.
UPLOAD_DIR=/var/www/nexchat-data/uploads

# Generate once with:  npx web-push generate-vapid-keys
# The server mints a temporary pair when these are blank and logs it — but a
# fresh pair on every restart invalidates every push subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@chax.nexarrow.eu

# ── Firebase Cloud Messaging, for the Android app ─────────────────────────────
# The web client is delivered to over Web Push (the VAPID keys above); a native
# app cannot receive that, so Android devices register an FCM token instead and
# the server routes per device. Both transports run side by side.
#
# From the Firebase console, in the project whose Android app is registered as
# eu.nexarrow.chax:  Project settings → Service accounts → Generate new private
# key. Put the file somewhere the API can read and point at it here.
#
# Leave blank and the Android app falls back to its socket transport, which only
# delivers while the app is running.
FCM_SERVICE_ACCOUNT=/var/www/nexchat-data/firebase-service-account.json
# Or, for a container that would rather not mount a file, the same JSON inline:
# FCM_SERVICE_ACCOUNT_JSON=

# Signs forensic export Merkle roots, so an export's timestamp does not rest on
# the exporting device's own clock. Generate once, on the server:
#   node -e "crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign']).then(async k=>console.log(Buffer.from(await crypto.subtle.exportKey('pkcs8',k.privateKey)).toString('base64')))"
# Leave it blank and the server mints a temporary key per restart, which makes
# every attestation it has already issued permanently unverifiable.
FORENSIC_ATTEST_KEY=

# ── TURN relay, for calls ─────────────────────────────────────────────────────
# STUN only tells a peer its own public address. It cannot get packets through a
# symmetric NAT, which is what most mobile carriers use — so without a relay a
# real share of phone-to-phone calls never connect, and they fail by hanging in
# "Connecting…" rather than by erroring, which is exactly what "calls don't
# work" looks like.
#
# Set up coturn on this box with deploy/setup-turn.sh, which prints the two
# lines to paste here. TURN_SECRET is coturn's `static-auth-secret` and must
# match /etc/turnserver.conf exactly.
#
# The secret never leaves the server: the browser asks GET /api/calls/ice and
# gets back a credential valid for TURN_TTL_SECONDS, derived from this secret.
# That is the difference between a relay only your users can use and an open
# proxy anyone who reads the JavaScript bundle can run traffic through — so do
# not put a relay password in the frontend's NEXT_PUBLIC_ variables instead.
#
# Leave blank and calls still work between devices that can reach each other
# directly, and the call screen says why when one cannot.
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=43200
