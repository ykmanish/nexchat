# Copy to /var/www/nexchat/frontend/.env.production on the server.
#
# This is read at BUILD time, not at runtime: `NEXT_PUBLIC_*` values are
# inlined into the client bundle by `next build`. The file must therefore be
# in place before the build runs, and changing it later requires a rebuild,
# not just a restart.
#
# One value drives three things — the REST base (+ '/api'), the Socket.IO
# origin, and every attachment URL — so it has to be the public origin,
# with no trailing slash and no port.
NEXT_PUBLIC_API_URL=https://chax.nexarrow.eu

# ── TURN relay (calls) ────────────────────────────────────────────────────────
# Configured on the API, not here. The browser asks GET /api/calls/ice and gets
# a credential that expires in hours, minted from a secret it never sees. See
# TURN_URLS / TURN_SECRET in deploy/backend.env.example, and run
# deploy/setup-turn.sh to stand up coturn on this box.
#
# These three remain only for a hosted relay whose credentials are genuinely
# static and unavoidable. Anything set here is readable by anyone who loads the
# page, so treat it as public: a relay named here can be used by strangers, on
# your bandwidth. Prefer the API route.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
