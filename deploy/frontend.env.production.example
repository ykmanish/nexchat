# Copy to /var/www/nexchat/frontend/.env.production on the server.
#
# This is read at BUILD time, not at runtime: `NEXT_PUBLIC_*` values are
# inlined into the client bundle by `next build`. The file must therefore be
# in place before the build runs, and changing it later requires a rebuild,
# not just a restart.
#
# One value drives three things — the REST base (+ '/api'), the Socket.IO
# origin, and every attachment URL — so it has to be the public origin,
# with no trailing slash and no port.
NEXT_PUBLIC_API_URL=https://chax.nexarrow.eu

# ── TURN relay (calls) ────────────────────────────────────────────────────────
# STUN alone only tells a peer its own public address. It cannot get packets
# through a symmetric NAT, which is what most mobile carriers use — so without
# a relay a real share of phone-to-phone calls never connect, and they fail by
# hanging in "Connecting…" rather than by erroring.
#
# Any TURN server will do. A self-hosted coturn on the same box is the cheapest
# option; Cloudflare, Twilio and Metered all sell hosted ones with generated
# short-lived credentials.
#
#   NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
#   NEXT_PUBLIC_TURN_USERNAME=chax
#   NEXT_PUBLIC_TURN_CREDENTIAL=a-long-shared-secret
#
# Left blank, calls still work between two devices that can reach each other
# directly, and the call screen says so when one fails.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
