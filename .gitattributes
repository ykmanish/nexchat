# Normalise line endings in the repo, and force LF on checkout for files that
# are executed on Linux. A CRLF shell script fails on the server with an
# opaque "\r: command not found", so these must never carry CRLF.
* text=auto

*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.cjs  text eol=lf

# Binary assets must not be touched at all.
*.png  binary
*.jpg  binary
*.ico  binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.pem  binary
